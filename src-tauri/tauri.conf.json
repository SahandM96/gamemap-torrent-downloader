{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameMap Torrent Desk",
  "version": "0.1.0",
  "identifier": "ir.gamemap.torrent-desk",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "python3 -m http.server 1420 --directory ui --bind 127.0.0.1",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Torrent Desk · GameMap Studio",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": ["../NOTICE", "../DONATE.md"],
    "externalBin": ["../sidecars/aria2c"],
    "category": "Utility",
    "shortDescription": "Local torrent search + aria2c manager by GameMap Studio",
    "longDescription": "GameMap Torrent Desk searches public torrent indexes and manages downloads via a bundled aria2c sidecar (GPL-2+, separate process).",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
